# Rufus Arch Linux Port Makefile
CC = gcc
CFLAGS = -Wall -Wextra -O2 $(shell pkg-config --cflags gtk+-3.0 openssl)
LIBS = $(shell pkg-config --libs gtk+-3.0 openssl) -lpthread

TARGET = rufus-linux
SRC = src/rufus_linux.c

all: $(TARGET)

$(TARGET): $(SRC)
	$(CC) $(CFLAGS) $(SRC) -o $(TARGET) $(LIBS)

clean:
	rm -f $(TARGET)

.PHONY: all clean
